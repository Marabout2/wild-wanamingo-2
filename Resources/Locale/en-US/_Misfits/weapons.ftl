# Ported from Misfits (https://github.com/Misfit-Sanctuary/nuclear-14): Resources/Locale/en-US/_Misfits/
# (cycling and sear strings changed: Wild Wanamingo cycles by using the gun in hand, and the sear popups were plain text)

gun-manual-action-needs-cycle = Cycle the firearm's action before firing again (use it in hand).
gun-manual-action-examine = This firearm needs its action cycled between shots (use it in hand).
misfits-foldable-ammo-box-verb = Fold into cardboard
firearm-sear-install-start = You begin installing the sear.
firearm-sear-install-done = The sear locks permanently into the firearm's action.
firearm-sear-incompatible = This firearm is not compatible with that sear.
firearm-sear-already-installed = This firearm already has a permanent sear upgrade.
firearm-sear-mode-present = This firearm already supports that fire mode.
firearm-sear-unload-first = Unload the firearm completely before installing a sear.
