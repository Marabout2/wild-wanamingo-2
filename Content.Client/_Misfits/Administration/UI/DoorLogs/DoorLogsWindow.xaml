<!-- Ported from Misfits (https://github.com/Misfit-Sanctuary/nuclear-14): Content.Client/_Misfits/Administration/UI/DoorLogs/DoorLogsWindow.xaml -->
<!-- Misfits: door destruction log admin panel -->
<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'misfits-door-logs-title'}" MinSize="900 500">
    <BoxContainer Orientation="Vertical" Margin="4">
        <Label Text="{Loc 'misfits-door-logs-heading'}" Margin="0 0 0 4" StyleClasses="LabelHeadingBig" />
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 4" SeparationOverride="12">
            <Label Text="{Loc 'misfits-door-logs-column-time'}" MinWidth="160" StyleClasses="LabelSubText" />
            <Label Text="{Loc 'misfits-door-logs-column-door'}" MinWidth="420" StyleClasses="LabelSubText" />
            <Label Text="{Loc 'misfits-door-logs-column-destroyer'}" MinWidth="200" StyleClasses="LabelSubText" />
        </BoxContainer>
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" MinSize="0 200">
            <BoxContainer Name="LogList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
